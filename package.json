{
  "name": "textline",
  "productName": "Textline",
  "version": "1.0.1",
  "description": "Schneller Text- und Code-Editor mit Farben für viele Sprachen und Python zum Ausführen.",
  "main": "src/main.js",
  "private": true,
  "desktopName": "win.mert.Textline",
  "scripts": {
    "bundle": "node build.mjs",
    "start": "node build.mjs && electron .",
    "icon": "node tools/make-icon.js",
    "build": "node build.mjs && electron-builder",
    "build:win": "node build.mjs && electron-builder -w"
  },
  "license": "MIT",
  "author": {
    "name": "erqf1",
    "email": "erqf1@users.noreply.github.com"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "codemirror": "^6.0.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^18.1.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "iconv-lite": "^0.7.3"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "esbuild@0.28.2": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erqf1/textline.git"
  },
  "engines": {
    "node": ">=22.2"
  },
  "build": {
    "appId": "win.mert.Textline",
    "productName": "Textline",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/files.js",
      "src/python.js",
      "src/shared/**/*",
      "src/renderer/index.html",
      "src/renderer/style.css",
      "src/renderer/dist/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "afterPack": "tools/afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "erqf1",
      "repo": "textline"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "assets/filetypes",
          "to": "filetypes",
          "filter": [
            "light/*.ico",
            "dark/*.ico"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Textline-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "Textline-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "syncDesktopName": true,
      "synopsis": "Text- und Code-Editor mit Farben für viele Sprachen und Python",
      "artifactName": "Textline-${version}-${arch}.${ext}",
      "mimeTypes": [
        "text/plain",
        "text/markdown",
        "text/x-markdown",
        "text/x-log",
        "text/csv",
        "text/tab-separated-values",
        "application/json",
        "application/xml",
        "text/xml",
        "application/x-yaml",
        "application/toml",
        "text/x-python",
        "text/x-python3",
        "application/x-python-code",
        "text/html",
        "text/css",
        "text/x-scss",
        "application/javascript",
        "text/javascript",
        "application/typescript",
        "text/x-csrc",
        "text/x-chdr",
        "text/x-c++src",
        "text/x-c++hdr",
        "text/x-csharp",
        "text/x-java",
        "text/x-go",
        "text/rust",
        "application/x-ruby",
        "application/x-php",
        "text/x-lua",
        "application/x-shellscript",
        "text/x-sql",
        "text/x-tex",
        "text/x-diff",
        "application/x-desktop",
        "text/x-cmake",
        "text/x-makefile",
        "image/svg+xml"
      ],
      "desktop": {
        "entry": {
          "Keywords": "text;editor;code;python;notepad;"
        }
      },
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "Textline-${version}-amd64.${ext}"
    },
    "pacman": {
      "artifactName": "Textline-${version}-x86_64.${ext}"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "fileAssociations": [
        {
          "ext": [
            "txt",
            "text"
          ],
          "name": "TXT file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/txt.icns"
        },
        {
          "ext": [
            "log"
          ],
          "name": "LOG file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/log.icns"
        },
        {
          "ext": [
            "md",
            "markdown",
            "rst"
          ],
          "name": "MD file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/md.icns"
        },
        {
          "ext": [
            "py",
            "pyw",
            "pyi"
          ],
          "name": "PY file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/py.icns"
        },
        {
          "ext": [
            "html",
            "htm"
          ],
          "name": "HTML file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/html.icns"
        },
        {
          "ext": [
            "css",
            "scss",
            "sass",
            "less"
          ],
          "name": "CSS file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/css.icns"
        },
        {
          "ext": [
            "js",
            "mjs",
            "cjs",
            "jsx"
          ],
          "name": "JS file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/js.icns"
        },
        {
          "ext": [
            "ts",
            "tsx"
          ],
          "name": "TS file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/ts.icns"
        },
        {
          "ext": [
            "json",
            "jsonc"
          ],
          "name": "JSON file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/json.icns"
        },
        {
          "ext": [
            "xml"
          ],
          "name": "XML file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/xml.icns"
        },
        {
          "ext": [
            "yaml",
            "yml"
          ],
          "name": "YML file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/yaml.icns"
        },
        {
          "ext": [
            "ini"
          ],
          "name": "INI file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/ini.icns"
        },
        {
          "ext": [
            "toml"
          ],
          "name": "TOML file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/toml.icns"
        },
        {
          "ext": [
            "cfg",
            "conf",
            "properties",
            "env",
            "gitignore",
            "editorconfig"
          ],
          "name": "CFG file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/config.icns"
        },
        {
          "ext": [
            "csv",
