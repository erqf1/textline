          "name": "CSV file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/csv.icns"
        },
        {
          "ext": [
            "sql"
          ],
          "name": "SQL file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/sql.icns"
        },
        {
          "ext": [
            "sh",
