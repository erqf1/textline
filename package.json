        },
        {
          "ext": [
            "kt",
            "kts"
          ],
          "name": "KT file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/kt.icns"
        },
        {
          "ext": [
            "go"
          ],
          "name": "GO file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/go.icns"
        },
        {
          "ext": [
            "rs"
          ],
          "name": "RS file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/rs.icns"
        },
        {
          "ext": [
            "rb"
          ],
          "name": "RB file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/rb.icns"
        },
        {
          "ext": [
            "php"
          ],
          "name": "PHP file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/php.icns"
        },
        {
          "ext": [
            "lua"
          ],
          "name": "LUA file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/lua.icns"
        },
        {
          "ext": [
            "svg"
          ],
          "name": "SVG file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/svg.icns"
        },
        {
          "ext": [
            "tex"
          ],
          "name": "TEX file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/tex.icns"
        },
        {
          "ext": [
            "diff",
            "patch"
          ],
          "name": "DIFF file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/diff.icns"
        },
        {
          "ext": [
            "srt"
          ],
          "name": "SRT file",
          "role": "Editor",
          "icon": "assets/filetypes/mac/srt.icns"
        },
        {
          "ext": [
            "vue",
            "svelte",
            "pl",
            "r",
            "swift",
            "dart",
            "scala",
            "cmake",
            "gradle",
            "groovy",
            "hs",
            "elm",
            "erl",
            "ex",
            "exs",
            "clj",
            "jl",
            "nim",
            "zig",
            "v",
            "sv",
            "vhd",
            "asm",
            "s",
            "f90",
            "pas",
            "m",
            "mm",
            "vb",
            "fs",
            "ml",
            "proto",
            "graphql",
            "dockerfile",
            "nix",
            "tf"
          ],
          "name": "Source code",
          "role": "Editor",
          "icon": "assets/filetypes/mac/code.icns"
        }
      ],
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Textline-${version}-mac-${arch}.${ext}"
    }
  }
}
